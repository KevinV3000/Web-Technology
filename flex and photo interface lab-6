<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Document</title>
  <style>

    h2{
      text-align: center;
    }
    .photo
    {
      width:20%;
    }
    .photo img{
      width:100%;
      background-color:lightgray;
      border-radius: 5px;
    }
    .photo img:hover
    {
      transform: scale(1.05);
    }
    .gallery
    {
      display:flex;
      gap:30px;
      flex-wrap: wrap;
      justify-content: center;

    }
    @media (max-width:500px) {
        .photo
        {
          width: 20%;
        }
    }
    @media (max-width:200px) {
        .photo
        {
          width: 50%;
        }
    }
  </style>
</head>
<body>
  <h2>Photo Gallery</h2>
  <div class="gallery">

        <div class="photo"><img src="shaan1.jpeg" alt="Photo 1"></div>
        <div class="photo"><img src="shaan2.jpeg" alt="Photo 2"></div>
        <div class="photo"><img src="shaan3.jpeg" alt="Photo 3"></div>
        <div class="photo"><img src="shaan4.jpeg" alt="Photo 4"></div>
        <div class="photo"><img src="shaan5.jpeg" alt="Photo 5"></div>
        <div class="photo"><img src="shaan6.jpeg" alt="Photo 6"></div>
        <div class="photo"><img src="shaan7.jpeg" alt="Photo 7"></div>
        <div class="photo"><img src="shaan8.jpeg" alt="Photo 8"></div>

    </div>
</body>
</html>
