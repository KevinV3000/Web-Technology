    }

    .profile-card {
        width: 100%;
    }

    .projects-container {
        grid-template-columns: 1fr 1fr;
    }

    .learning {
        margin-left: 5%;
        margin-right: 5%;
    }
}


/* ================= MOBILE ================= */

@media (max-width: 600px) {

    header {
        flex-direction: column;
        gap: 20px;
    }

    nav {
        flex-wrap: wrap;
        justify-content: center;
    }

    nav a {
        font-size: 12px;
    }


    .hero {
