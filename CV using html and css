* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    background: #f5f8fc;
    color: #172033;
    font-family: Arial, Helvetica, sans-serif;
    line-height: 1.6;
}


/* ================= HEADER ================= */

header {
    width: 100%;
    padding: 20px 8%;
    display: flex;
    justify-content: space-between;
    align-items: center;

    background: white;
    border-bottom: 1px solid #dce4ee;

    position: sticky;
    top: 0;
    z-index: 100;
}

.logo {
    font-size: 24px;
    font-weight: bold;
    letter-spacing: 2px;
}

.logo span {
    color: #1479ff;
}

nav {
    display: flex;
    gap: 25px;
}

nav a {
    color: #596579;
    text-decoration: none;
    font-size: 14px;
    transition: 0.3s;
}

nav a:hover {
    color: #1479ff;
}


/* ================= HERO ================= */

.hero {
    min-height: 90vh;

    display: flex;
    justify-content: space-between;
    align-items: center;

    padding: 80px 10%;
    gap: 70px;

    background:
        radial-gradient(circle at 80% 30%, #dcecff, transparent 30%),
        #f5f8fc;
}

.hero-text {
    flex: 1;
}

.small-text {
    color: #1479ff;
    letter-spacing: 4px;
    font-size: 13px;
    margin-bottom: 20px;
    font-family: monospace;
}

.hero h1 {
    font-size: 75px;
    line-height: 1.05;
    margin-bottom: 20px;
}

.hero h1 span {
    color: #1479ff;
}

.hero h2 {
    color: #4e5d73;
    font-size: 22px;
    font-weight: normal;
    margin-bottom: 20px;
}

.description {
    max-width: 600px;
    color: #68758a;
    margin-bottom: 30px;
}

.buttons {
    display: flex;
    gap: 15px;
}

.btn {
    display: inline-block;
    padding: 12px 25px;

    background: #1479ff;
    color: white;

    text-decoration: none;
    font-weight: bold;

    border: 1px solid #1479ff;

    transition: 0.3s;
}

.btn:hover {
    background: #0d62d1;
}

.btn.outline {
    background: transparent;
    color: #1479ff;
}

.btn.outline:hover {
    background: #1479ff;
    color: white;
}


/* ================= TERMINAL ================= */

.terminal {
    flex: 0 0 430px;

    background: white;

    border: 1px solid #d8e1ec;
    border-radius: 10px;

    box-shadow: 0 15px 40px rgba(35, 75, 120, 0.12);

    overflow: hidden;
}

.terminal-top {
    height: 45px;

    display: flex;
    align-items: center;

    padding: 0 15px;

    background: #eef3f8;

    border-bottom: 1px solid #d8e1ec;
}

.terminal-top p {
    margin-left: 15px;
    color: #657389;
    font-size: 13px;
}

.dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    margin-right: 7px;
}

.red {
    background: #ff5f56;
}

.yellow {
    background: #ffbd2e;
}

.green {
    background: #27c93f;
}

.terminal-body {
    padding: 25px;

    font-family: monospace;

    min-height: 300px;
}

.terminal-body p {
    margin-bottom: 10px;
}

.green-text {
    color: #1479ff;
}

.output {
    color: #526176;
    padding-left: 15px;
}

.status {
    color: #168c4b;
    padding-left: 15px;
}


/* ================= STATS ================= */

.stats {
    background: white;

    border-top: 1px solid #dce4ee;
    border-bottom: 1px solid #dce4ee;

    display: grid;
    grid-template-columns: repeat(4, 1fr);

    padding: 30px 10%;
}

.stats div {
    text-align: center;
    border-right: 1px solid #dce4ee;
}

.stats div:last-child {
    border-right: none;
}

.stats h2 {
    color: #1479ff;
    font-size: 32px;
}

.stats p {
    color: #718096;
    font-size: 13px;
}


/* ================= SECTIONS ================= */

.section {
    padding: 100px 10%;
}

.section-title {
    margin-bottom: 50px;
}

.section-title p {
    color: #1479ff;
    font-family: monospace;
    margin-bottom: 8px;
}

.section-title h2 {
    font-size: 42px;
    color: #172033;
}


/* ================= ABOUT ================= */

.about-container {
    display: flex;
    gap: 70px;
    align-items: center;
}

.profile-card {
    flex: 1;

    padding: 40px;

    background: white;

    border: 1px solid #d8e1ec;
    border-radius: 10px;

    text-align: center;

    box-shadow: 0 10px 30px rgba(35, 75, 120, 0.08);
}

.profile-circle {
    width: 160px;
    height: 160px;

    margin: 0 auto 25px;

    border-radius: 50%;

    display: flex;
    justify-content: center;
    align-items: center;

    background: #e8f2ff;

    border: 3px solid #1479ff;

    color: #1479ff;

    font-size: 45px;
    font-weight: bold;
}

.profile-card h3 {
    font-size: 22px;
}

.profile-card p {
    color: #718096;
}

.location {
    margin-top: 15px;
    color: #1479ff;
    font-size: 14px;
}

.about-text {
    flex: 2;
}

.about-text h3 {
    font-size: 30px;
    margin-bottom: 20px;
}

.about-text h3 span {
    color: #1479ff;
}

.about-text > p {
    color: #66748a;
    margin-bottom: 15px;
}

.quick-info {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 15px;
    margin-top: 30px;
}

.quick-info div {
    padding: 15px;

    border: 1px solid #d8e1ec;
    background: white;

    border-radius: 6px;
}

.quick-info b {
    display: block;

    font-size: 11px;
    color: #1479ff;

    margin-bottom: 5px;
}

.quick-info span {
    color: #526176;
    font-size: 14px;
}


/* ================= SKILLS ================= */

.skills-container {
    display: grid;

    grid-template-columns: 1fr 1fr;

    gap: 20px;
}

.skill-card {
    padding: 25px;

    background: white;

    border: 1px solid #d8e1ec;
    border-radius: 8px;

    transition: 0.3s;

    box-shadow: 0 5px 20px rgba(35, 75, 120, 0.05);
}

.skill-card:hover {
    border-color: #1479ff;

    transform: translateY(-5px);

    box-shadow: 0 10px 25px rgba(20, 121, 255, 0.12);
}

.skill-heading {
    display: flex;
    justify-content: space-between;

    margin-bottom: 15px;
}

.skill-heading h3 {
    font-size: 18px;
}

.skill-heading span {
    color: #1479ff;
}

.progress {
    width: 100%;
    height: 6px;

    background: #e5ebf2;

    margin-bottom: 10px;

    border-radius: 10px;

    overflow: hidden;
}

.progress-bar {
    height: 100%;

    background: #1479ff;

    border-radius: 10px;
}

.html {
    width: 90%;
}

.css {
    width: 85%;
}

.c {
    width: 80%;
}

.java {
    width: 75%;
}

.sql {
    width: 80%;
}

.dbms {
    width: 75%;
}

.skill-card p {
    color: #78869a;
    font-size: 13px;
}


/* ================= PROJECTS ================= */

.projects-container {
    display: grid;

    grid-template-columns: repeat(3, 1fr);

    gap: 20px;
}

.project-card {
    min-height: 320px;

    padding: 30px;

    background: white;

    border: 1px solid #d8e1ec;
    border-radius: 8px;

    display: flex;
    flex-direction: column;

    transition: 0.3s;

    box-shadow: 0 5px 20px rgba(35, 75, 120, 0.05);
}

.project-card:hover {
    transform: translateY(-8px);

    border-color: #1479ff;

    box-shadow: 0 15px 35px rgba(20, 121, 255, 0.12);
}

.project-number {
    color: #1479ff;

    font-family: monospace;

    font-size: 14px;

    margin-bottom: 35px;
}

.project-card h3 {
    font-size: 25px;

    margin-bottom: 15px;
}

.project-card p {
    color: #718096;

    font-size: 14px;

    margin-bottom: 20px;
}

.tags {
    display: flex;
    gap: 8px;

    margin-top: auto;
    margin-bottom: 20px;
}

.tags span {
    padding: 5px 10px;

    border: 1px solid #cfd9e5;

    color: #5d6b7e;

    font-size: 11px;

    border-radius: 4px;
}

.project-card a {
    color: #1479ff;

    text-decoration: none;

    font-size: 13px;
}


/* ================= EDUCATION ================= */

.timeline {
    max-width: 800px;

    border-left: 2px solid #d8e1ec;

    padding-left: 40px;
}

.timeline-item {
    position: relative;

    display: flex;

    gap: 30px;

    margin-bottom: 50px;
}

.timeline-item::before {
    content: "";

    position: absolute;

    left: -49px;
    top: 5px;

    width: 15px;
    height: 15px;

    background: #1479ff;

    border-radius: 50%;

    box-shadow: 0 0 12px rgba(20, 121, 255, 0.4);
}

.year {
    color: #1479ff;

    font-family: monospace;

    min-width: 50px;
}

.timeline-content {
    background: white;

    border: 1px solid #d8e1ec;

    border-radius: 8px;

    padding: 25px;

    flex: 1;

    box-shadow: 0 5px 20px rgba(35, 75, 120, 0.05);
}

.timeline-content h3 {
    margin-bottom: 5px;
}

.timeline-content p {
    color: #718096;
}

.timeline-content span {
    display: inline-block;

    margin-top: 10px;

    color: #1479ff;

    font-size: 12px;
}


/* ================= LEARNING ================= */

.learning {
    margin: 0 10% 100px;

    padding: 50px;

    background: #eaf3ff;

    border: 1px solid #cfe2fa;

    border-radius: 10px;

    display: flex;

    justify-content: space-between;

    align-items: center;

    gap: 40px;
}

.learning > div:first-child p {
