    background: white;

    border-top: 1px solid #dce4ee;

    display: flex;

    justify-content: space-between;

    align-items: center;

    color: #718096;

    font-size: 12px;
}


/* ================= TABLET ================= */

@media (max-width: 900px) {

    header {
        padding: 20px 5%;
    }

    nav {
        gap: 12px;
    }

    .hero {
        padding: 70px 5%;
        flex-direction: column;
        align-items: stretch;
    }

    .terminal {
