<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Marwadi - Department of Computer Engineering</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet">

    <style>

        /* Main Marwadi Color Palette */
        :root {
            --marwadi-brown: #A78A6C;
            --marwadi-teal: #01A3BA;
            --marwadi-black: #000000;
            --marwadi-light: #F8F7F5;
            --marwadi-grey: #BBBBBB;
            --marwadi-dark-brown: #8F7458;
        }


        /* Body */

        body {
            background-color: var(--marwadi-light);
            color: #333333;
            font-family: Arial, Helvetica, sans-serif;
        }


        /* Header */

        header {
            background-color: white;
            border-bottom: 5px solid var(--marwadi-brown);
            padding: 30px !important;
        }

        header img {
            width: 180px !important;
        }

        header h1 {
            color: var(--marwadi-brown);
            font-size: 40px;
        }

        header h2 {
            color: var(--marwadi-black);
        }


        /* Navigation */

        nav {
            background-color: var(--marwadi-teal) !important;
            padding: 15px !important;
        }

        nav a {
            color: white !important;
            transition: 0.3s;
        }

        nav a:hover {
            color: var(--marwadi-black) !important;
            background-color: white;
            padding: 8px 12px;
            border-radius: 5px;
        }


        /* Sections */

        section {
            margin-top: 30px;
            margin-bottom: 30px;
        }


        /* Cards */

        .card {
            border: none;
            border-top: 5px solid var(--marwadi-brown);
            border-radius: 8px;
            background-color: white;
        }

        .card-body {
            padding: 25px;
        }


        /* Headings */

        .card h3 {
            color: var(--marwadi-brown) !important;
            border-bottom: 2px solid var(--marwadi-teal);
            padding-bottom: 10px;
            margin-bottom: 20px;
        }


        /* Lists */

        .list-group-item {
            border-left: 4px solid var(--marwadi-teal);
            margin-bottom: 5px;
            background-color: #FFFFFF;
        }


        /* Recruiters */

        .alert {
            border: none;
            text-align: center;
            font-weight: bold;
            padding: 15px;
        }

        .alert-primary {
            background-color: var(--marwadi-brown);
            color: white;
        }

        .alert-primary:hover {
            background-color: var(--marwadi-dark-brown);
        }


        /* Footer */

        footer {
            background-color: var(--marwadi-brown) !important;
            color: white;
            margin-top: 40px;
        }

    </style>

</head>


<body>


    <!-- Header -->

    <header class="text-center">

        <img
            src="MU_LOGO_BROWN.jpg"
            alt="Marwadi University Logo"
            class="img-fluid mb-3">

        <h1 class="fw-bold">
            Marwadi University
        </h1>

        <h2 class="h4">
            Department of Computer Engineering
        </h2>

    </header>



    <!-- Navigation -->

    <nav class="text-center">

        <a href="#vision"
           class="text-decoration-none fw-bold mx-2">
            Vision
        </a>

        <a href="#mission"
           class="text-decoration-none fw-bold mx-2">
            Mission
        </a>

        <a href="#pso"
           class="text-decoration-none fw-bold mx-2">
            Programs Specific Outcomes
        </a>

        <a href="#courses"
           class="text-decoration-none fw-bold mx-2">
            Courses Offered
        </a>

        <a href="#recruiters"
           class="text-decoration-none fw-bold mx-2">
            Top Recruiters
        </a>

    </nav>



    <!-- Vision -->

    <section id="vision" class="container">

        <div class="card shadow-sm">

            <div class="card-body">

                <h3 class="fw-bold">
                    Vision
                </h3>

                <p>
                    To impart quality technical education through research,
                    innovation and teamwork for creating professionally superior
                    and ethically strong manpower that meets the global
                    challenges of engineering industries and research
                    organizations.
                </p>

            </div>

        </div>

    </section>



    <!-- Mission -->

    <section id="mission" class="container">

        <div class="card shadow-sm">

            <div class="card-body">

                <h3 class="fw-bold">
                    Mission
                </h3>

                <ul class="list-group">

                    <li class="list-group-item">
                        Maintain state-of-the-art ICT enabled teaching and
                        learning methodologies.
                    </li>

                    <li class="list-group-item">
                        Enable graduates to become digital age literates,
                        innovators, and professionals.
                    </li>

                    <li class="list-group-item">
                        Provide skills, knowledge, and attitudes for success
                        as engineers, leaders, and entrepreneurs.
                    </li>

                    <li class="list-group-item">
                        Prepare graduates for lifelong learning and career
                        challenges.
                    </li>

                </ul>

            </div>

        </div>

    </section>



    <!-- Program Specific Outcomes -->

    <section id="pso" class="container">

        <div class="card shadow-sm">

            <div class="card-body">

                <h3 class="fw-bold">
                    Programs Specific Outcomes
                </h3>

                <ol class="list-group list-group-numbered">

                    <li class="list-group-item">
                        Apply knowledge and competence in the design and
                        development of computer-based systems addressing
                        industrial and social needs.
                    </li>

                    <li class="list-group-item">
                        Adapt to emerging technological advancements including
                        cybersecurity, AR/VR, and IoT.
                    </li>

                </ol>

            </div>

        </div>

    </section>



    <!-- Courses -->

    <section id="courses" class="container">

        <div class="card shadow-sm">

            <div class="card-body">

                <h3 class="fw-bold">
                    Courses Offered
                </h3>

                <ul class="list-group">

                    <li class="list-group-item">
                        B.Tech in Computer Engineering
                    </li>

                    <li class="list-group-item">
                        M.Tech in Computer Engineering
                    </li>

                    <li class="list-group-item">
                        Ph.D. in Computer Engineering
                    </li>

                    <li class="list-group-item">
                        B.Tech in Information Technology
                    </li>

                </ul>

            </div>

        </div>

    </section>



    <!-- Recruiters -->

    <section id="recruiters" class="container">

        <div class="card shadow-sm">

            <div class="card-body">

                <h3 class="fw-bold">
                    Top Recruiters
                </h3>

                <div class="row">

                    <div class="col-md-4 mb-3">
                        <div class="alert alert-primary">
                            Microsoft
                        </div>
                    </div>

                    <div class="col-md-4 mb-3">
                        <div class="alert alert-primary">
                            Google
                        </div>
                    </div>

                    <div class="col-md-4 mb-3">
                        <div class="alert alert-primary">
                            Amazon
                        </div>
                    </div>

                    <div class="col-md-4 mb-3">
                        <div class="alert alert-primary">
                            Infosys
                        </div>
                    </div>

                    <div class="col-md-4 mb-3">
                        <div class="alert alert-primary">
                            TCS
                        </div>
                    </div>

                    <div class="col-md-4 mb-3">
                        <div class="alert alert-primary">
                            Wipro
                        </div>
                    </div>

                    <div class="col-md-4 mb-3">
                        <div class="alert alert-primary">
                            IBM
                        </div>
                    </div>

                </div>

            </div>

        </div>

    </section>



    <!-- Footer -->

    <footer class="text-center p-3">

        <p class="mb-0">

            &copy; 2025 Marwadi University -
            Department of Computer Engineering

        </p>

    </footer>


</body>

</html>
