
/* ===== Premium Powder Blue Theme ===== */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, Helvetica, sans-serif;
    background: linear-gradient(
        135deg,
        #dbeafe,
        #b0d4f1,
        #87bde8
    );
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 20px;
}

/* ===== Main Quiz Card ===== */

.quiz-container {
    background: #ffffff;
    border-radius: 20px;
    padding: 40px 35px;
    width: 100%;
    max-width: 580px;
    box-shadow: 0 25px 70px rgba(44, 82, 130, 0.22);
}

/* ===== Cover Page ===== */

.cover-icon {
    font-size: 60px;
    text-align: center;
    color: #5b9bd5;
    margin-bottom: 15px;
}

.cover-title {
    text-align: center;
    font-size: 27px;
    color: #17365d;
    font-weight: bold;
    margin-bottom: 10px;
}

.cover-subtitle {
    text-align: center;
    color: #647b91;
    font-size: 15px;
    line-height: 1.6;
    margin-bottom: 28px;
}

/* ===== Rules ===== */

.cover-rules {
    list-style: none;
    background: #f0f7ff;
    border: 1px solid #c5e0f7;
    border-radius: 12px;
    padding: 18px 20px;
    margin-bottom: 28px;
}

.cover-rules li {
    color: #284b70;
    font-size: 15px;
    padding: 12px 0;
    border-bottom: 1px solid #d7e9f8;
}

.cover-rules li:last-child {
    border-bottom: none;
}

/* ===== Buttons ===== */

.start-btn,
.next-btn {
    display: block;
    width: 100%;
    padding: 15px;
    background: linear-gradient(
        135deg,
        #7db9e8,
        #4682c4
    );
    color: #ffffff;
    border: none;
    border-radius: 10px;
    font-size: 16px;
    font-weight: bold;
    cursor: pointer;
    letter-spacing: 0.3px;
    transition: 0.25s ease;
}

.start-btn:hover,
.next-btn:hover {
    background: linear-gradient(
        135deg,
        #5b9bd5,
        #3267a8
    );
    box-shadow: 0 7px 18px rgba(70, 130, 196, 0.3);
    transform: translateY(-2px);
}

.start-btn:active,
.next-btn:active {
    transform: translateY(0);
}

/* ===== Quiz Screen ===== */

.quiz-title {
    text-align: center;
    color: #17365d;
    font-size: 22px;
    margin-bottom: 22px;
}

/* ===== Progress Bar ===== */

.progress-bar-bg {
    background: #e2effb;
    border-radius: 20px;
    height: 9px;
    margin-bottom: 13px;
    overflow: hidden;
}

.progress-bar {
    height: 100%;
    background: linear-gradient(
        90deg,
        #a7d4f5,
        #4682c4
    );
    border-radius: 20px;
    width: 0%;
    transition: width 0.4s ease;
}

/* ===== Question Counter ===== */

.question-counter {
    text-align: right;
    color: #4682c4;
    font-size: 13px;
    font-weight: bold;
    margin-bottom: 18px;
}

/* ===== Question ===== */

.question-text {
    font-size: 18px;
    color: #243b53;
    font-weight: bold;
    margin-bottom: 22px;
    line-height: 1.6;
    min-height: 55px;
}

/* ===== Answer Options ===== */

.options-container {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: 20px;
}

.option-btn {
    background: #fafdff;
    border: 2px solid #d4e6f5;
    border-radius: 10px;
    padding: 14px 16px;
    font-size: 15px;
    text-align: left;
    cursor: pointer;
    color: #35516e;
    transition: 0.2s ease;
}

.option-btn:hover {
    background: #edf6ff;
    border-color: #8abce5;
    transform: translateX(3px);
}

.option-btn.selected {
    background: linear-gradient(
        135deg,
        #7db9e8,
        #4682c4
    );
    border-color: #4682c4;
    color: #ffffff;
    font-weight: bold;
    transform: translateX(3px);
}

/* ===== Warning Message ===== */

.warning-msg {
    color: #285b91;
    font-size: 13px;
    margin-bottom: 14px;
    display: none;
    background: #edf6ff;
    padding: 11px 13px;
    border-radius: 8px;
    border-left: 4px solid #5b9bd5;
}

/* ===== Result Screen ===== */

.result-icon {
    font-size: 62px;
    text-align: center;
    margin-bottom: 15px;
}

.score-text {
    text-align: center;
    font-size: 30px;
    font-weight: bold;
    color: #3267a8;
    margin: 18px 0 15px;
}

/* ===== Score Bar ===== */

.score-bar-bg {
    background: #e2effb;
    border-radius: 20px;
    height: 13px;
    margin-bottom: 22px;
    overflow: hidden;
}

.score-bar {
    height: 100%;
    background: linear-gradient(
        90deg,
        #a7d4f5,
        #4682c4
    );
    border-radius: 20px;
    width: 0%;
    transition: width 0.8s ease;
}

.result-msg {
    text-align: center;
    font-size: 16px;
    color: #647b91;
    margin-bottom: 28px;
    line-height: 1.7;
}

/* ===== Restart Button ===== */

.restart-btn {
    display: block;
    width: 100%;
    padding: 15px;
    background: linear-gradient(
        135deg,
        #7db9e8,
        #4682c4
    );
    color: #ffffff;
    border: none;
    border-radius: 10px;
    font-size: 16px;
    font-weight: bold;
    cursor: pointer;
    transition: 0.25s ease;
}

.restart-btn:hover {
    background: linear-gradient(
        135deg,
        #5b9bd5,
        #3267a8
    );
    box-shadow: 0 7px 18px rgba(70, 130, 196, 0.3);
    transform: translateY(-2px);
}

.restart-btn:active {
    transform: translateY(0);
}

/* ===== Utility ===== */

.hidden {
    display: none;
}

/* ===== Responsive Design ===== */

@media (max-width: 480px) {
    .quiz-container {
        padding: 28px 20px;
        border-radius: 16px;
    }

    .cover-title {
        font-size: 22px;
    }

    .cover-icon {
        font-size: 50px;
    }

    .quiz-title {
        font-size: 19px;
    }

    .question-text {
        font-size: 16px;
    }

    .option-btn {
        font-size: 14px;
        padding: 12px;
    }

    .score-text {
        font-size: 25px;
    }
}
